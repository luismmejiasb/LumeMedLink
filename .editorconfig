root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_style = space
indent_size = 4
max_line_length = 120

# ktlint — the repo config wins over any local preference (family rule).
ktlint_code_style = intellij_idea
ktlint_standard_trailing-comma-on-call-site = enabled
ktlint_standard_trailing-comma-on-declaration-site = enabled
# @Composable functions are PascalCase: that is the Compose convention and ktlint does not know it.
ktlint_function_naming_ignore_when_annotated_with = Composable, Test
ktlint_standard_import-ordering = enabled

[*.{yml,yaml,toml,json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
