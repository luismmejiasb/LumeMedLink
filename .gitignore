# Gradle
.gradle/
build/
**/build/

# Kotlin
.kotlin/

# IDE
.idea/
*.iml
local.properties

# macOS
.DS_Store

# Xcode (the iOS host)
xcuserdata/
*.xcworkspace/xcshareddata/swiftpm/

# Credentials and signing material (F20, ADR-0018).
# This section is not hypothetical hygiene: every commit in this repo is made with `git add -A`,
# so a keystore or a google-services.json dropped in the tree would be committed on the next one.
# The audit found ZERO coverage here and a clean history — this keeps the second half true.
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
.env
.env.*
google-services.json
GoogleService-Info.plist
keystore.properties
secrets.properties
*.mobileprovision
service-account*.json

# Xcode local state — the project and the scheme are committed; user state and build output are not.
iosApp/**/xcuserdata/
iosApp/**/*.xcworkspace/xcuserdata/

# Apple signing and API keys (APNs, App Store Connect) and heap dumps, which carry tokens and
# whatever the process held (task 0002, F21).
*.p8
*.hprof
/captures/
