<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Backup posture (F6, ADR-0015). The two attributes are COMPLEMENTARY, not alternatives, and
         the reason is measured, not assumed: allowBackup="false" stops cloud backup, but on
         targetSdk >= 31 the platform deliberately ignores it for device-to-device migration
         (compat change IGNORE_ALLOW_BACKUP_IN_D2D). Verified on a live emulator: the D2D transport
         extracted this package's data while the cloud transport refused it. dataExtractionRules is
         what closes that path. Neither line may be removed without reopening ADR-0015.
         FLAG_SECURE landed in F1 (ADR-0010, set in MainActivity). -->
    <application
        android:label="LumeMedLink"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:supportsRtl="true"
        android:theme="@style/Theme.LumeMedLink">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
